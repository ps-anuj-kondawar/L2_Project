# ChemShield AI — Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env or secret API keys to source control.

# Google Gemini LLM API Key (Required for multi-agent reasoning, summary & SDS authoring)
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Search API Key (Required for live web safety limit lookups)
TAVILY_API_KEY=your_tavily_api_key_here

# Vector Database Settings
CHROMA_PERSIST_DIR=./chroma_db

# Server Configuration
HOST=127.0.0.1
PORT=7860
